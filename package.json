{
  "name": "popcornfx-web",
  "version": "0.1.0",
  "description": "Standalone browser viewer for PopcornFX 1.13.5 particle effects (.pkfx).",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "lint": "eslint .",
    "check": "npm run lint && npm test && npm run build",
    "corpus": "node scripts/corpus-check.mjs",
    "index-pack": "node scripts/pack-index.mjs"
  },
  "keywords": [
    "popcornfx",
    "pkfx",
    "particles",
    "vfx",
    "webgl2",
    "trove"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "vite": "^8.3.1"
  }
}
